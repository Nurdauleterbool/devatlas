# Copy to observability/.env and fill a unique strong password.
# Never commit observability/.env to Git.
GRAFANA_ADMIN_PASSWORD=

# Optional: leave blank to use safe non-AI fallback and skip GitHub Issue creation.
# To enable, use a restricted key/token with costs and repository permissions reviewed.
OPENAI_API_KEY=
GITHUB_TOKEN=
GITHUB_REPOSITORY=Nurdauleterbool/devatlas
